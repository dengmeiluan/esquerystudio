<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.3.12.RELEASE</version>
        <relativePath/>
    </parent>

    <groupId>io.github.dengmeiluan</groupId>
    <artifactId>esquerystudio-boot-support-boot23-it</artifactId>
    <version>1.0.99</version>
    <name>ESQueryStudio Boot 2.3 Embedding IT</name>
    <description>Integration proof that the shared boot-support library embeds into a Boot 2.3
        (QuoteHub baseline) host and serves the console against an ES 6.7-shaped cluster.
        Test-only module: not a product artifact.</description>

    <properties>
        <java.version>1.8</java.version>
        <elasticsearch.client.version>7.17.15</elasticsearch.client.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.dengmeiluan</groupId>
            <artifactId>esquerystudio-boot-support</artifactId>
            <version>1.0.99</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.elasticsearch.client</groupId>
            <artifactId>elasticsearch-rest-client</artifactId>
            <version>${elasticsearch.client.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.junit.vintage</groupId>
                    <artifactId>junit-vintage-engine</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
</project>
