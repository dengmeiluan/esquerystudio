<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.dengmeiluan</groupId>
        <artifactId>esquerystudio</artifactId>
        <version>1.0.99</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>esquerystudio-es-engine</artifactId>
    <name>ESQueryStudio ES Engine</name>
    <description>Spring-neutral Elasticsearch index/alias/reindex engine (es-rest based) shared by the
        console and every Boot host baseline. Java 8 bytecode; no Spring dependency; the host supplies
        the low-level REST client through EsClientContext or directly.</description>

    <dependencies>
        <dependency>
            <groupId>io.github.dengmeiluan</groupId>
            <artifactId>esquerystudio-es-rest</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.elasticsearch.client</groupId>
            <artifactId>elasticsearch-rest-client</artifactId>
            <version>7.17.15</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.13.5</version>
            <scope>provided</scope>
        </dependency>
        <!-- databind 2.13 needs core >= 2.12; the console Boot parent manages core to 2.11,
             so pin the pair here (hosts supply matching core+databind at runtime). -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
            <version>2.13.5</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <version>2.13.5</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>1.7.36</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>1.7.36</version>
            <scope>test</scope>
        </dependency>
        <!-- ES low-level client logs through commons-logging; hosts supply it. -->
        <dependency>
            <groupId>commons-logging</groupId>
            <artifactId>commons-logging</artifactId>
            <version>1.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
