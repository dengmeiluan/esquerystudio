<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.2.0</version>
        <relativePath/>
    </parent>

    <groupId>io.github.dengmeiluan</groupId>
    <artifactId>esquerystudio-console-boot4</artifactId>
    <version>1.0.99</version>
    <name>ESQueryStudio Console (Boot 4)</name>
    <description>Parallel Spring Boot 4 / Java 17 artifact for Elasticsearch 9.x.
        Phase 0: reuses the shared boot-support core and the existing Vue console assets.</description>

    <properties>
        <java.version>17</java.version>
        <elasticsearch.client.version>9.5.7</elasticsearch.client.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.dengmeiluan</groupId>
            <artifactId>esquerystudio-boot-support</artifactId>
            <version>1.0.99</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.elasticsearch.client</groupId>
            <artifactId>elasticsearch-rest-client</artifactId>
            <version>${elasticsearch.client.version}</version>
        </dependency>
        <!-- Boot 4's starter-web no longer brings Jackson 2 (the JSON stack moved on); the shared
             MCP/engine code is compiled against Jackson 2, so the adapter app supplies the fixed 2.x line. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.18.11</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- No-op: keeps `-Pboot4 -pl modules/console-boot4` warning-free. -->
        <profile>
            <id>boot4</id>
        </profile>
    </profiles>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- The Vue console travels inside esquerystudio-boot-support (single source);
                 the app jar must not duplicate it. -->
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
