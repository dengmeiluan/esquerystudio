<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <groupId>io.github.dengmeiluan</groupId>
    <artifactId>esquerystudio-console-boot2</artifactId>
    <version>1.0.95</version>
    <name>ESQueryStudio Console (Boot 2 host adapter)</name>
    <description>Boot 2.7 / Java 17 host adapter over the unified es-rest + boot-support core.
        One modern request path (ES 8.x/9.x), no 6.x/7.x branches.</description>

    <properties>
        <java.version>17</java.version>
        <elasticsearch.client.version>8.18.1</elasticsearch.client.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.dengmeiluan</groupId>
            <artifactId>esquerystudio-boot-support</artifactId>
            <version>1.0.95</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.elasticsearch.client</groupId>
            <artifactId>elasticsearch-rest-client</artifactId>
            <version>${elasticsearch.client.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>boot2</id>
        </profile>
    </profiles>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- The Vue console travels inside esquerystudio-boot-support (single source);
                 the app jar must not duplicate it. -->
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
